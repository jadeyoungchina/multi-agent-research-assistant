# ============================================================
# Multi-Agent Research Assistant - 环境变量模板
# 基于 upstream: NirDiamant/GenAI_Agents 实际代码审计生成
#
# 使用方法：
#   1. 复制本文件为 .env  (cp .env.example .env)
#   2. 在 .env 中填入真实值
#   3. 禁止将 .env 提交到 Git（.gitignore 已排除）
# ============================================================

# ---------- 必需（upstream 核心教程均依赖，29 处引用） ----------
# OpenAI 云端 LLM API Key，获取：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------- 可选（仅部分 upstream 教程使用，按需填写） ----------

# Tavily 搜索 API（网络搜索类 agent，2 处引用）
# 获取：https://tavily.com
# TAVILY_API_KEY=

# LangSmith 追踪（LangChain/LangGraph 调试与观测，1 处引用）
# 获取：https://smith.langchain.com
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=multi-agent-research-assistant

# Groq API（个别教程的替代 LLM 提供方，1 处引用）
# GROQ_API_KEY=

# Google Gemini API（个别教程使用，1 处引用）
# GOOGLE_API_KEY=

# NewsAPI（新闻类教程，2 处引用）
# NEWSAPI_KEY=
